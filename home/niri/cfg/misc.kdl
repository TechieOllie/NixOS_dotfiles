    prefer-no-csd
    screenshot-path null

    environment {
        ELECTRON_OZONE_PLATFORM_HINT "auto"
        QT_QPA_PLATFORM "wayland"
        QT_QPA_PLATFORMTHEME "qt6ct"
        QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
        XDG_CURRENT_DESKTOP "niri"
        XDG_SESSION_TYPE "wayland"
    }

    debug {
        // Allows notification actions and window activation from Noctalia.
        honor-xdg-activation-with-invalid-serial
    }

    hotkey-overlay {
       skip-at-startup
    }

    cursor {
       xcursor-theme "Bibata-Modern-Classic"
       xcursor-size 22
    }

    clipboard {
    disable-primary
    }

    // Global blur tuning (Noctalia v5 compositor-settings docs), paired
    // with the per-surface blur window-rule and layer-rules in rules.kdl.
    // Requires niri 26.04+ (this repo's pinned nixpkgs ships exactly that
    // version).
    //
    // xray is deliberately left at its default (niri turns it on
    // automatically wherever blur is active) rather than being forced off,
    // which is what rules.kdl used to do everywhere. Two reasons, in
    // order: niri's own docs mark non-xray effects *experimental* with
    // known limitations (they vanish during open/close animations and
    // while dragging a tiled window), and xray is far cheaper — it blurs
    // the wallpaper once and reuses it, instead of recomputing per window
    // on every move and every content change underneath. The look is not
    // a trade-off here: with the wallpaper in the backdrop
    // (place-within-backdrop, rules.kdl) there is nothing below a surface
    // *except* the wallpaper, so both modes sample the same thing.
    // Confirmed by pixel-diffing screenshots taken with and without
    // `xray false` — identical.
    // OFF along with the blur rules in rules.kdl — see the banner there.
    // Left in place because these are tuned values, not defaults, and
    // re-deriving them would mean redoing the pixel-diff work described
    // above.
    // blur {
    //     passes 2
    //     offset 3.0
    //     noise 0.03
    //     saturation 1.0
    // }

    // Command updated to Noctalia's current recommendation
    // (noctalia msg session lock-and-suspend, replacing the old plain
    // systemctl suspend-then-hibernate) — still commented out, since no
    // bootstrapped host has a lid switch yet (VM only; the laptop isn't
    // installed). Also needs services.logind's HandleLidSwitch=ignore at
    // the system level once a real laptop host enables this, so niri
    // itself handles the lid event instead of systemd — revisit then.
    //switch-events {
       //lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
    //}
