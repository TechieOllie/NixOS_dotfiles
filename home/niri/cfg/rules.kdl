    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    // Noctalia v5 compositor-settings docs: blur, applied broadly then
    // tuned down for Noctalia's own surfaces (bar/notification/dock/panel/
    // attached-panel/osd) so they don't look see-through, plus the window
    // switcher specifically. https://docs.noctalia.dev/v5/compositor-settings/niri
    window-rule {
        background-effect {
            blur true
            xray false
        }
    }

    layer-rule {
        match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
        background-effect {
            xray false
        }
    }

    layer-rule {
        match namespace="noctalia-window-switcher"
        background-effect {
            blur true
            xray false
        }
    }

    // Noctalia v5's own settings window, floating rather than tiled.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // Same opacity treatment as Zen (matching the shared value in
    // home/transparency.nix) — pure compositor-level effect, no GTK CSS
    // changes needed. UNLIKE Zen, focus-ring stays enabled here rather than
    // off: niri's own default-config.kdl explains the focus-ring/border
    // "solid background rectangle" bleed-through only happens because it
    // has nowhere else to go for windows with no room around them — Zen is
    // open-maximized-to-edges (zero gap, fills the whole output, so
    // draw-border-with-background false left an empty gap with nothing to
    // render into), but Nautilus is a normal tiled window with real gap
    // space (layout.kdl's gaps 16) for the ring to draw into. So
    // draw-border-with-background false here should give a real,
    // correctly-colored ring in that gap space instead of bleeding through
    // the translucent content — not the "off" treatment Zen needed.
    window-rule {
        match app-id="org.gnome.Nautilus"
        opacity 0.80
        draw-border-with-background false
    }

    window-rule {
        match app-id=r#"^zen(-\w+)?$"#
        open-maximized-to-edges true
        // Compositor-level opacity, independent of Transparent Zen's own
        // CSS-based transparency (which needs Zen/Gecko to actually render
        // an alpha-channel surface — niri isn't in that mod's confirmed-
        // working list, only KDE/Hyprland are). This applies regardless of
        // whether that works, so it's the reliable fallback. Value matches
        // the shared opacity in home/transparency.nix — kept in sync by
        // hand, same as misc.kdl's duplicated cursor block.
        opacity 0.80
        // prefer-no-csd (misc.kdl) already asks Zen to drop its own
        // decorations. Matches Nautilus's fix (below/rules.kdl) rather than
        // disabling focus-ring/border outright — deliberately, even though
        // it currently reintroduces the empty-transparent-gap bug this
        // exact line previously fixed (`focus-ring { off } border { off
        // }`): niri's own default-config.kdl explains the ring/border
        // "solid background" bleed-through only happens because it has
        // nowhere else to render for a window with no surrounding space,
        // and Zen is currently open-maximized-to-edges (zero gap, fills
        // the whole output) — there's genuinely nowhere for the ring to go
        // as long as that stays true. Kept as draw-border-with-background
        // false anyway, at the operator's explicit request, so this is
        // already correct the moment open-maximized-to-edges is ever
        // removed (making Zen a normal tiled window with real gap space,
        // like Nautilus) — revert to focus-ring/border off if
        // maximized-to-edges stays and the gap artifact bothers you before
        // then.
        draw-border-with-background false
    }

    // Same treatment as Nautilus (opacity matching transparency.nix,
    // draw-border-with-background false, focus-ring stays enabled) rather
    // than Zen's — Vesktop uses plain open-maximized below, not
    // open-maximized-to-edges, which per niri's own docs still respects
    // gaps/struts, so it has real gap space for the ring to draw into,
    // same as Nautilus. Pairs with Vesktop's own VencordSettings.store.transparent
    // (home/vesktop.nix) as a compositor-level fallback independent of
    // whether Electron's own transparency renders correctly here.
    window-rule {
        match app-id="vesktop"
        opacity 0.80
        draw-border-with-background false
    }

    window-rule {
        match app-id="steam$"
        match app-id="obsidian$"
        match app-id="vesktop$"
        open-maximized true
    }

    window-rule {
        match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
        default-floating-position x=10 y=10 relative-to="bottom-right"
    }

    window-rule {
       match app-id=r#"^zen(-\w+)?$"# title="^Picture-in-Picture$"
       open-maximized-to-edges false
       open-floating true
       default-floating-position x=32 y=32 relative-to="bottom-right"
       default-column-width { fixed 480; }
       default-window-height { fixed 270; }
    }
