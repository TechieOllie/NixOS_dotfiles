    // The global window corner radius moved OUT of this file, to
    // ~/.config/niri/noctalia-style.kdl (included from config.kdl), so it
    // shares one source of truth with Noctalia's bar radius — home/noctalia.nix's
    // `style` block. It was 20 here while Noctalia's bar was 12; they are now
    // both style.radius. Don't add a geometry-corner-radius back here: a
    // second bare window-rule setting it would silently win or lose depending
    // on include order.

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    // ─────────────────────────────────────────────────────────────────────
    // BLUR IS CURRENTLY OFF, at the operator's request. Everything from here
    // to the end of this banner is commented out rather than deleted: the
    // findings below took months to establish and are the reason the setup
    // works at all when it *is* on. Re-enabling is uncommenting these three
    // blocks plus, in home/noctalia.nix, shell.panel.transparency_mode =
    // "glass" and a home/transparency.nix value below 1.0 — the compositor
    // half alone does nothing without client-side alpha, which is precisely
    // what the note below explains.
    // ─────────────────────────────────────────────────────────────────────
    //
    // Blur, enabled broadly for windows and explicitly for Noctalia's own
    // layer surfaces. https://docs.noctalia.dev/v5/compositor-settings/niri
    //
    // IMPORTANT, and the thing that made blur look completely broken for
    // months: this only ever becomes *visible* on a surface that is
    // genuinely semi-transparent on the client side — an app that renders
    // its own background with an alpha channel (Ghostty's
    // background-opacity, Noctalia's bar background_opacity and its
    // shell.panel.transparency_mode = "glass"). niri's own `opacity`
    // window-rule below is NOT that: it fades the whole already-composited
    // window over whatever is actually behind it, so the wallpaper shows
    // through sharp and the blur never appears. Verified live by
    // screenshotting Ghostty and Vesktop side by side on the same
    // wallpaper — Ghostty's backdrop was smeared, Vesktop's stars were
    // pin-sharp. Giving an app real blur means finding real client-side
    // transparency for it; there is no compositor-side substitute.
    // window-rule {
    //     background-effect {
    //         blur true
    //     }
    // }

    // A window-rule does not apply to layer-shell surfaces, so Noctalia's
    // bar/panels/OSD need blur enabled here in their own right — this
    // block previously set only `xray false` and therefore never enabled
    // blur on any of them at all.
    // layer-rule {
    //     match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
    //     background-effect {
    //         blur true
    //     }
    // }

    // layer-rule {
    //     match namespace="noctalia-window-switcher"
    //     background-effect {
    //         blur true
    //     }
    // }

    // Noctalia v5's own settings window, floating rather than tiled.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // Same opacity treatment as Zen (matching the shared value in
    // home/transparency.nix) — pure compositor-level effect, no GTK CSS
    // changes needed. This buys transparency only, never blur: see the
    // background-effect block at the top of this file for why the two are
    // not the same mechanism. GTK gives us no client-side alpha to work
    // with, so tinting is the whole of what Nautilus can have here.
    // focus-ring stays enabled here rather than off: niri's own
    // default-config.kdl explains the focus-ring/border "solid background
    // rectangle" bleed-through only happens because it has nowhere else to
    // go for windows with no room around them, and Nautilus is a normal
    // tiled window with real gap space (layout.kdl's gaps 16) for the ring
    // to draw into. So draw-border-with-background false here gives a real,
    // correctly-colored ring in that gap space instead of bleeding through
    // the translucent content. Zen used to be the counter-example that made
    // this contrast worth drawing (open-maximized-to-edges, zero gap,
    // nowhere for the ring to go); it isn't any more — see its block below.
    window-rule {
        match app-id="org.gnome.Nautilus"
        // opacity 0.80  // OFF: see the blur banner above
        draw-border-with-background false
    }

    // Zen is a normal tiled window at full column width, deliberately NOT
    // open-maximized-to-edges. It was the latter until 2026-08-21, and that
    // was the whole of a long-standing "Zen crashes on start" report: niri
    // opened it maximized, then Zen restored its own remembered window
    // state from ~/.config/zen/<profile>/xulstore.json, whose main-window
    // sizemode was "normal". That sends xdg_toplevel.unset_maximized, niri
    // drops the window to an ordinary tiled column, and layout.kdl defines
    // preset-column-widths but no default-column-width — so it landed on
    // niri's built-in proportion 0.5, i.e. half the screen. The visible
    // "crash" was that transition; the half-width geometry then got written
    // back to xulstore.json on close, which is what made it recur. Fixing
    // it here rather than in xulstore.json is the point: Zen owns that file
    // and rewrites it every time it closes, so an edit there is undone.
    // See docs/decisions.md.
    window-rule {
        match app-id=r#"^zen(-\w+)?$"#
        // Full width, but as a normal column — so unlike
        // open-maximized-to-edges it still respects layout.kdl's gaps 16.
        // That surrounding gap space is what makes
        // draw-border-with-background false correct below.
        default-column-width { proportion 1.0; }
        // Compositor-level opacity, independent of Transparent Zen's own
        // CSS-based transparency (which needs Zen/Gecko to actually render
        // an alpha-channel surface — niri isn't in that mod's confirmed-
        // working list, only KDE/Hyprland are). This applies regardless of
        // whether that works, so it's the reliable fallback — for
        // *transparency*. Blur rides on the mod's client-side alpha, not on
        // this line, so if the backdrop through Zen looks sharp then the
        // mod isn't rendering alpha and no niri setting will change that.
        // Value matches
        // the shared opacity in home/transparency.nix — kept in sync by
        // hand, same as misc.kdl's duplicated cursor block.
        // opacity 0.80  // OFF: see the blur banner above
        // prefer-no-csd (misc.kdl) already asks Zen to drop its own
        // decorations. Same treatment as Nautilus above rather than
        // disabling focus-ring/border outright. This line used to
        // reintroduce an empty-transparent-gap bug that `focus-ring { off }
        // border { off }` had previously fixed — niri's own
        // default-config.kdl explains the ring/border "solid background"
        // bleed-through only happens when there is nowhere else to render,
        // which was exactly Zen's situation while it was maximized to edges
        // with zero surrounding space. It now has real gap space like
        // Nautilus, so the ring draws where it should and the artifact is
        // gone. Keep this as-is unless open-maximized-to-edges ever comes
        // back, in which case revert to focus-ring/border off.
        draw-border-with-background false
    }

    // Same treatment as Nautilus and Zen (opacity matching transparency.nix,
    // draw-border-with-background false, focus-ring stays enabled).
    // Vesktop uses plain open-maximized below, which per niri's own docs
    // still respects gaps/struts, so it has real gap space for the ring to
    // draw into. Since 2026-08-21 every window in this file does — nothing
    // uses open-maximized-to-edges any more (see the Zen block above), so
    // this is no longer the contrast it once was.
    // Pairs with Vesktop's own VencordSettings.store.transparent
    // (home/vesktop.nix) as a compositor-level fallback independent of
    // whether Electron's own transparency renders correctly here.
    // `transparent` is currently false there (Phase 6 dropped the whole
    // CSS/Electron-transparency approach), so in practice this window has
    // tinting and no blur — Vesktop was the control in the live comparison
    // that established the distinction described at the top of this file.
    window-rule {
        match app-id="vesktop"
        // opacity 0.80  // OFF: see the blur banner above
        draw-border-with-background false
        open-on-output "Samsung Electric Company C27F390 H4ZR113985"
    }

    window-rule {
        match app-id="steam$"
        match app-id="obsidian$"
        match app-id="vesktop$"
        open-maximized true
    }

    window-rule {
        match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
        default-floating-position x=10 y=10 relative-to="bottom-right"
    }

    window-rule {
       match app-id=r#"^zen(-\w+)?$"# title="^Picture-in-Picture$"
       // An `open-maximized-to-edges false` used to sit here purely to
       // cancel the base Zen rule above; that rule no longer sets it, so the
       // line was dead and is gone. The fixed sizes below still override
       // that rule's default-column-width.
       open-floating true
       default-floating-position x=32 y=32 relative-to="bottom-right"
       default-column-width { fixed 480; }
       default-window-height { fixed 270; }
    }
