    // The global window corner radius moved OUT of this file, to
    // ~/.config/niri/noctalia-style.kdl (included from config.kdl), so it
    // shares one source of truth with Noctalia's bar radius — home/noctalia.nix's
    // `style` block. It was 20 here while Noctalia's bar was 12; they are now
    // both style.radius. Don't add a geometry-corner-radius back here: a
    // second bare window-rule setting it would silently win or lose depending
    // on include order.

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    // ─────────────────────────────────────────────────────────────────────
    // BLUR IS CURRENTLY OFF, at the operator's request. Everything from here
    // to the end of this banner is commented out rather than deleted: the
    // findings below took months to establish and are the reason the setup
    // works at all when it *is* on. Re-enabling is uncommenting these three
    // blocks plus, in home/noctalia.nix, shell.panel.transparency_mode =
    // "glass" and a home/transparency.nix value below 1.0 — the compositor
    // half alone does nothing without client-side alpha, which is precisely
    // what the note below explains.
    // ─────────────────────────────────────────────────────────────────────
    //
    // Blur, enabled broadly for windows and explicitly for Noctalia's own
    // layer surfaces. https://docs.noctalia.dev/v5/compositor-settings/niri
    //
    // IMPORTANT, and the thing that made blur look completely broken for
    // months: this only ever becomes *visible* on a surface that is
    // genuinely semi-transparent on the client side — an app that renders
    // its own background with an alpha channel (Ghostty's
    // background-opacity, Noctalia's bar background_opacity and its
    // shell.panel.transparency_mode = "glass"). niri's own `opacity`
    // window-rule below is NOT that: it fades the whole already-composited
    // window over whatever is actually behind it, so the wallpaper shows
    // through sharp and the blur never appears. Verified live by
    // screenshotting Ghostty and Vesktop side by side on the same
    // wallpaper — Ghostty's backdrop was smeared, Vesktop's stars were
    // pin-sharp. Giving an app real blur means finding real client-side
    // transparency for it; there is no compositor-side substitute.
    // window-rule {
    //     background-effect {
    //         blur true
    //     }
    // }

    // A window-rule does not apply to layer-shell surfaces, so Noctalia's
    // bar/panels/OSD need blur enabled here in their own right — this
    // block previously set only `xray false` and therefore never enabled
    // blur on any of them at all.
    // layer-rule {
    //     match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
    //     background-effect {
    //         blur true
    //     }
    // }

    // layer-rule {
    //     match namespace="noctalia-window-switcher"
    //     background-effect {
    //         blur true
    //     }
    // }

    // Noctalia v5's own settings window, floating rather than tiled.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    window-rule {
        match app-id="org.gnome.Nautilus"
        // opacity 0.80  // OFF: see the blur banner above
        draw-border-with-background false
    }

    // See docs/decisions.md.
    window-rule {
        match app-id=r#"^zen(-\w+)?$"#
        match app-id=r#"^md.obsidian.Obsidian?$"#
        match app-id=r#"^steam?$"#
        // default-column-width { proportion 1.0; }
        open-maximized true
        draw-border-with-background false
    }

        window-rule {
        match app-id="vesktop"
        // opacity 0.80  // OFF: see the blur banner above
        draw-border-with-background false
        open-on-output "Samsung Electric Company C27F390 H4ZR113985"
    }

    window-rule {
        match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
        default-floating-position x=10 y=10 relative-to="bottom-right"
    }

    window-rule {
       match app-id=r#"^zen(-\w+)?$"# title="^Picture-in-Picture$"
       open-floating true
       default-floating-position x=32 y=32 relative-to="bottom-right"
       default-column-width { fixed 480; }
       default-window-height { fixed 270; }
    }
